ARG BASE_IMAGE=armlimited/arm-mcp:latest
FROM ${BASE_IMAGE}

# Reuse the release's /app/.venv. Add local Python dependencies here so this
# layer stays cached when only the source changes, for example:
# RUN python -m pip install --no-cache-dir 'your-package==1.2.3'

COPY mcp-local/server.py /app/server.py
COPY mcp-local/utils/ /app/utils/
COPY arm_kb_search/ /app/arm_kb_search/
