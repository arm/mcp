# syntax=docker/dockerfile:1.7

# These platform-specific manifests make the current generator image an
# explicitly ARM64 build. Update both digests deliberately when upgrading.
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.9.2@sha256:387eb4de25210101cc2f53ce74ee9c9d60da4618a7aff8c41b9c8d472cc783da
ARG PYTHON_IMAGE=docker.io/library/python:3.13-slim@sha256:800ac3fc34cb04346a5669cc677cb4d65e23be59e1b64a1efa60fe4b230263ff

FROM ${UV_IMAGE} AS uv
FROM ${PYTHON_IMAGE} AS builder

ENV PATH="/embedding-data/.venv/bin:${PATH}" \
    UV_PYTHON_DOWNLOADS=never

COPY --from=uv /uv /bin/uv

WORKDIR /embedding-data

# Install exactly the locked runtime dependencies. The project is a script
# application, so there is no project package to install.
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --locked --no-dev --no-install-project --no-cache

# Acquire the pinned model while this stage still has network access.
COPY acquire-model.py embedding-model.lock.json ./
RUN HF_HOME=/tmp/huggingface python acquire-model.py \
        --lock embedding-model.lock.json \
        --output /embedding-data/embedding-model \
    && rm -rf /tmp/huggingface

# Confirm the saved model can be loaded without consulting any remote service.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1
RUN --network=none python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('/embedding-data/embedding-model', local_files_only=True, trust_remote_code=False)"

FROM ${PYTHON_IMAGE} AS generator

ENV PATH="/embedding-data/.venv/bin:${PATH}" \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

WORKDIR /embedding-data

# uv is intentionally build-only. The final generator contains the locked
# environment, local model, and generation programs, but no package manager.
COPY --from=builder /embedding-data/.venv /embedding-data/.venv
COPY --from=builder /embedding-data/embedding-model /embedding-data/embedding-model
COPY document_chunking.py generate-chunks.py local_vectorstore_creation.py \
    embedding-model.lock.json ./
