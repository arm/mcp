# syntax=docker/dockerfile:1.7

# The workflow supplies both named contexts as immutable image references.
FROM toolchain AS acquisition

ENV YAML_OUTPUT_DIR=/snapshot/yaml_data \
    CHUNK_DETAILS_FILE=/snapshot/chunk_details.csv

WORKDIR /work

COPY vector-db-sources.csv vector-db-sources.csv
COPY --from=intrinsic-chunks \
    /embedding-data/intrinsic_chunks/ \
    /snapshot/intrinsic_chunks/

RUN --network=none mkdir -p "${YAML_OUTPUT_DIR}" /work/info

# Discovery is intentionally enabled during this controlled network phase.
RUN --network=default \
    python /embedding-data/generate-chunks.py /work/vector-db-sources.csv

FROM scratch AS chunks

COPY --from=acquisition \
    /snapshot/intrinsic_chunks/ \
    /embedding-data/intrinsic_chunks/
COPY --from=acquisition \
    /snapshot/yaml_data/ \
    /embedding-data/yaml_data/
COPY --from=acquisition \
    /work/vector-db-sources.csv \
    /embedding-data/vector-db-sources.csv
COPY --from=acquisition \
    /snapshot/chunk_details.csv \
    /embedding-data/chunk_details.csv
