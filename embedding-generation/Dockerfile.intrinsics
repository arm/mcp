# syntax=docker/dockerfile:1.7

FROM toolchain AS refresh
WORKDIR /refresh
COPY intrinsic_catalog.py document_chunking.py ./
COPY --from=intrinsic-chunks /embedding-data/intrinsic_chunks/ /previous/
RUN --network=default python intrinsic_catalog.py \
    --existing /previous --output /snapshot/intrinsic_chunks \
    --model-path /embedding-data/embedding-model

FROM scratch AS snapshot
COPY --from=refresh /snapshot/intrinsic_chunks/ /embedding-data/intrinsic_chunks/
